<button class="cx-caption-preset" data-obs data-caption-preset="hormozi"><span class="cx-cap-preset-glyph">Aa</span><span class="cx-cap-preset-name">Hormozi</span><span class="cx-cap-preset-dot" style="background:#ffe600"></span></button>
<button class="cx-caption-preset" data-obs data-caption-preset="bigword"><span class="cx-cap-preset-glyph">Aa</span><span class="cx-cap-preset-name">Big Word</span><span class="cx-cap-preset-dot" style="background:#ff4d8d"></span></button>
<button class="cx-caption-preset" data-obs data-caption-preset="classy"><span class="cx-cap-preset-glyph">Aa</span><span class="cx-cap-preset-name">Classy FFX</span><span class="cx-cap-preset-dot" style="background:#7b61ff"></span></button>
<button class="cx-caption-preset" data-obs data-caption-preset="beasty"><span class="cx-cap-preset-glyph">Aa</span><span class="cx-cap-preset-name">Beasty</span><span class="cx-cap-preset-dot" style="background:#ff4d8d"></span></button>
<button class="cx-caption-preset" data-obs data-caption-preset="neon"><span class="cx-cap-preset-glyph">Aa</span><span class="cx-cap-preset-name">Neon</span><span class="cx-cap-preset-dot" style="background:#5fffa6"></span></button>
<button class="cx-caption-preset" data-obs data-caption-preset="chrome"><span class="cx-cap-preset-glyph">Aa</span><span class="cx-cap-preset-name">Chrome</span><span class="cx-cap-preset-dot" style="background:#c9ced8"></span></button>
<button class="cx-caption-preset" data-obs data-caption-preset="spotlight"><span class="cx-cap-preset-glyph">Aa</span><span class="cx-cap-preset-name">Spotlight</span><span class="cx-cap-preset-dot" style="background:#22ff6f"></span></button>
<button class="cx-caption-preset" data-obs data-caption-preset="letterrise"><span class="cx-cap-preset-glyph">Aa</span><span class="cx-cap-preset-name">Letter Rise</span><span class="cx-cap-preset-dot" style="background:#7b61ff"></span></button>
<button class="cx-caption-preset" data-obs data-caption-preset="banglaviral"><span class="cx-cap-preset-glyph">অ</span><span class="cx-cap-preset-name">Bangla Viral</span><span class="cx-cap-preset-dot" style="background:#ffe600"></span></button>
<button class="cx-caption-preset" data-obs data-caption-preset="news"><span class="cx-cap-preset-glyph">Aa</span><span class="cx-cap-preset-name">News Style</span><span class="cx-cap-preset-dot" style="background:#ffd166"></span></button>
