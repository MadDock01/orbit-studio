</div>
</div>
<details class="cx-cap-step cx-cap-fine-tuning" data-cap-stage-panel="style" hidden>
<summary>Advanced Fine Tuning</summary>
<div class="cx-cap-slider-row"><span class="cx-cap-slider-label">Speed</span><input id="flexCaptionSpeed" max="30" min="4" type="range" value="14"/><span class="cx-cap-slider-val" id="flexCaptionSpeedVal">47%</span></div>
<div class="cx-cap-slider-row"><span class="cx-cap-slider-label">Intensity</span><input id="flexCaptionIntensity" max="100" min="0" type="range" value="60"/><span class="cx-cap-slider-val" id="flexCaptionIntensityVal">60%</span></div>
<div class="cx-cap-slider-row"><span class="cx-cap-slider-label">Key Size</span><input id="flexCaptionKeywordScale" max="300" min="100" step="5" type="range" value="135" title="Keyword (*word*) size relative to normal captions"/><span class="cx-cap-slider-val" id="flexCaptionKeywordScaleVal">1.35x</span></div>
<div class="cx-cap-slider-row"><span class="cx-cap-slider-label">Key Glow</span><input id="flexCaptionKeywordGlow" max="100" min="0" type="range" value="40" title="Keyword glow intensity"/><span class="cx-cap-slider-val" id="flexCaptionKeywordGlowVal">40%</span></div>
</details>
<div class="cx-cap-bottom" data-cap-stage-panel="style" hidden>
<button class="tool-btn wide primary cx-cap-generate" data-obs disabled id="btnFlexCaptionCreate">✨ GENERATE CAPTIONS</button>
<div class="cx-cap-bottom-side">
<button class="tool-btn cx-cap-icon-btn" id="btnFlexUpdateCaptions" title="Update the visual style of captions already generated in After Effects">↻ UPDATE STYLE</button>
</div>
</div>
<div class="cx-cap-build-progress" hidden id="flexCaptionBuildProgress"><i></i><span>Preparing captions…</span></div>
</div>

<!-- Local AI still-image background removal -->
<div class="tool-section cx-ai-bg-card" id="studioAiBgRemover">
<div class="tool-section-head"><div class="tool-section-title">AI BACKGROUND REMOVER</div><span class="tool-help" title="Removes the background from one selected still-image layer locally with U²-Net. The result is imported as a transparent PNG and the original layer is kept as a disabled backup.">?</span></div>
<div class="cx-studio-context cx-bg-target-context"><span class="cx-context-icon">◇</span><b id="cxStudioCompLabel">NO ACTIVE COMP</b><i></i><span id="cxStudioSelectionLabel">SELECT ONE IMAGE LAYER</span><button type="button" id="btnStudioRefreshContext" title="Refresh the selected still-image layer">↻</button></div>
<div class="cx-bg-pipeline" id="aiBgPipeline" aria-label="Background removal steps">
<div class="cx-bg-pipeline-step is-active" data-bg-step="select"><span>1</span>Select</div>
<div class="cx-bg-pipeline-step" data-bg-step="process"><span>2</span>Process</div>
<div class="cx-bg-pipeline-step" data-bg-step="import"><span>3</span>Import</div>
</div>
<div class="cx-ai-bg-hero"><div class="cx-ai-bg-icon" aria-hidden="true"><i></i><b>AI</b></div><div><strong>STILL IMAGE → TRANSPARENT PNG</strong><span>Offline · unlimited use · original layer preserved</span></div></div>
<div class="cx-ai-bg-preview" id="aiBgPreview" role="button" tabindex="0" aria-label="Drop a still image or click to browse"><div class="cx-ai-bg-preview-empty"><b>DROP IMAGE HERE</b><span>PNG, JPG, JPEG or WebP · or select a layer in the comp</span></div><img id="aiBgPreviewImage" alt="Background removal result preview" hidden/></div>
<input accept=".png,.jpg,.jpeg,.webp,image/png,image/jpeg,image/webp" id="aiBgFileInput" style="display:none" type="file"/>
<div class="cx-caption-block"><div class="cx-caption-block-label">EDGE REFINEMENT</div>
<div class="counter-row"><label class="cx-range-label">Cleanup <input id="aiBgCutoff" max="35" min="0" step="1" type="range" value="5"/><span id="aiBgCutoffValue">5%</span></label><label class="cx-range-label">Feather <input id="aiBgFeather" max="12" min="0" step="1" type="range" value="1"/><span id="aiBgFeatherValue">1px</span></label></div>
</div>
<label class="caption-toggle cx-ai-bg-original-toggle"><input checked id="aiBgDisableOriginal" type="checkbox"/> Keep original as a disabled backup</label>
<div class="cx-dual-actions cx-ai-bg-actions">
<button class="tool-btn wide primary" id="btnAiRemoveBackground">REMOVE BACKGROUND</button>
<button class="tool-btn wide" id="btnAiBgRestore" title="Select a generated AI cutout layer first">RESTORE SELECTED ORIGINAL</button>
</div>
<div class="hint cx-ai-bg-status" id="aiBgStatus" role="status" aria-live="polite">Drop an image, click to browse, or select one still-image layer in the active composition.</div></div>
<div class="tool-section cx-exploder-card cx-ssae-card" id="ssToAeCard">
<div class="cx-exploder-head">
<span class="cx-exploder-bolt" aria-hidden="true">▦</span>
<div><div class="cx-exploder-title">SCREENSHOT → MOTION <span class="cx-ssae-beta">SMART DETECTION</span></div><div class="cx-ssae-subtitle">Detect, review and animate meaningful UI elements in After Effects</div></div>
<button class="tool-help cx-exploder-help" type="button" title="Hybrid Motion keeps the exact screenshot as its base, adds local recovery patches, and separates detected elements for animation." aria-label="About Screenshot Animator">?</button>
</div>

<div class="cx-exploder-drop cx-pro-dropzone cx-ssae-drop" id="ssToAeDropzone" role="button" tabindex="0" aria-label="Paste a UI screenshot (Ctrl+V), drop a file, or press Enter to browse">
<div class="cx-ssae-empty" id="ssToAeEmpty"><span class="cx-ssae-upload-icon">↥</span><strong>Drop or paste a UI screenshot</strong><small>PNG, JPG or WEBP — Ctrl+V, drag & drop, or click to browse</small></div>
<canvas id="ssToAePreviewCanvas" aria-label="Screenshot region preview"></canvas>
<div class="cx-ssae-preview-toolbar" id="ssToAePreviewToolbar" hidden><button type="button" data-ssae-type="all">ALL <b id="ssToAeCountAll">0</b></button><button type="button" data-ssae-type="text"><i class="is-text"></i>TEXT <b id="ssToAeCountText">0</b></button><button type="button" data-ssae-type="icon"><i class="is-icon"></i>ICON <b id="ssToAeCountIcon">0</b></button><button type="button" data-ssae-type="image"><i class="is-image"></i>IMAGE <b id="ssToAeCountImage">0</b></button><button type="button" data-ssae-type="shape"><i class="is-shape"></i>SHAPE <b id="ssToAeCountShape">0</b></button></div>
<input type="file" id="ssToAeFileInput" accept="image/png,image/jpeg,image/webp,.png,.jpg,.jpeg,.webp" hidden/>
</div>
<button class="cx-exploder-paste cx-ssae-timeline" id="btnSsToAeDetectTimeline" type="button">▤ DETECT SELECTED TIMELINE IMAGE</button>

<div class="cx-ssae-flow" aria-label="Screenshot Animator workflow"><span class="is-active"><b>1</b> SOURCE</span><span><b>2</b> REVIEW</span><span><b>3</b> BUILD</span></div>

<div class="cx-exploder-group">
<div class="cx-exploder-group-title">ADJUSTMENTS</div>
<label class="cx-exploder-field cx-ssae-mode"><span>Build Mode</span><select class="counter-select" id="ssToAeMode"><option value="layered">Hybrid Motion — Recommended</option><option value="safe">Original Screenshot — Static</option></select></label>
<div class="cx-exploder-sliders">
<label class="cx-exploder-slider"><span class="cx-exploder-slider-label">Detail</span><input type="range" id="ssToAeDetail" min="1" max="5" step="1" value="3"/><output id="ssToAeDetailVal" for="ssToAeDetail">3</output></label>
<label class="cx-exploder-slider"><span class="cx-exploder-slider-label">Region Padding</span><input type="range" id="ssToAeOffset" min="0" max="12" step="1" value="2"/><output id="ssToAeOffsetVal" for="ssToAeOffset">2px</output></label>
</div>
<div class="cx-ssae-options"><label><input type="checkbox" id="ssToAeGroupNested" checked/> Group nested elements</label><label><input type="checkbox" id="ssToAeAutoParent" checked/> Create group controllers</label><label><input type="checkbox" id="ssToAeAnimate" checked/> Apply entrance animation</label></div>
</div>

<div class="cx-exploder-group cx-ssae-layer-settings">
<div class="cx-exploder-group-title">LAYER SETTINGS <span>Per-type motion override</span></div>
<label class="cx-ssae-background-lock"><input type="checkbox" checked disabled/><span><b>Preserve Background Plate</b><small>Always keeps the original screenshot visually intact</small></span><em>SAFE</em></label>
<div class="cx-ssae-type-overrides">
<label><span><i class="is-text"></i>Text</span><select id="ssToAeMotionText"><option value="global">Global</option><option value="fade">Fade</option><option value="slideup">Slide Up</option><option value="scale">Scale In</option><option value="none">None</option></select></label>
<label><span><i class="is-icon"></i>Icon</span><select id="ssToAeMotionIcon"><option value="global">Global</option><option value="scale">Scale In</option><option value="fade">Fade</option><option value="slideup">Slide Up</option><option value="none">None</option></select></label>
<label><span><i class="is-image"></i>Image</span><select id="ssToAeMotionImage"><option value="global">Global</option><option value="smooth">Smooth UI</option><option value="scale">Scale In</option><option value="fade">Fade</option><option value="none">None</option></select></label>
<label><span><i class="is-shape"></i>Shape</span><select id="ssToAeMotionShape"><option value="global">Global</option><option value="fade">Fade</option><option value="scale">Scale In</option><option value="slideup">Slide Up</option><option value="none">None</option></select></label>
</div>
</div>

<div class="cx-exploder-group">
<div class="cx-exploder-group-title">ANIMATION</div>
<div class="cx-exploder-fields">
<label class="cx-exploder-field"><span>Motion</span><select class="counter-select" id="ssToAeMotion"><option value="smooth">Smooth UI</option><option value="slideup">Slide Up</option><option value="slidedown">Slide Down</option><option value="slideleft">Slide Left</option><option value="slideright">Slide Right</option><option value="scale">Scale In</option><option value="fade">Fade</option><option value="none">None</option></select></label>
<label class="cx-exploder-field"><span>Sequence</span><select class="counter-select" id="ssToAeSequence"><option value="top">Top to Bottom</option><option value="left">Left to Right</option><option value="largest">Largest First</option><option value="center">Center Out</option><option value="simultaneous">Simultaneous</option></select></label>
</div>
<div class="cx-exploder-sliders">
<label class="cx-exploder-slider"><span class="cx-exploder-slider-label">Animation Duration</span><input type="range" id="ssToAeDuration" min="0.15" max="2" step="0.05" value="0.55"/><output id="ssToAeDurationVal" for="ssToAeDuration">0.55s</output></label>
<label class="cx-exploder-slider"><span class="cx-exploder-slider-label">Layer Stagger</span><input type="range" id="ssToAeStagger" min="0" max="0.5" step="0.01" value="0.06"/><output id="ssToAeStaggerVal" for="ssToAeStagger">0.06s</output></label>
</div>
</div>

<div class="cx-ssae-summary" id="ssToAeSummary"><b>NO SCREENSHOT ANALYSED</b><span>Load an image, then click a detected region to include or exclude it.</span></div>
<div class="cx-ssae-actions"><button class="cx-exploder-paste" id="btnSsToAeAnalyze" type="button">⌁ ANALYSE REGIONS</button><button class="cx-exploder-build" id="btnSsToAeBuild" type="button" disabled><span>✓ BUILD ANIMATED UI</span></button></div>
<p class="cx-exploder-footer" id="ssToAeStatus" role="status" aria-live="polite">Hybrid Motion preserves the full screenshot and hides moving-element ghosts with local recovery patches.</p>
</div>
</div>
</div>
<!-- ═══════════════════════════════════════════════════════════════════
     TOOLKIT PANEL — Shape Toolkit · Timeline Filters · Layer Groups · FX Manager
     ═══════════════════════════════════════════════════════════════════ -->
<div class="app-panel" id="panel-toolkit">
<div class="tools-scroll">
<div class="tool-dash-row tools-project-row">
<div class="tool-section" id="toolkitRoundProSection">
<div class="tool-section-head">
<div class="tool-section-title">ROUND PRO</div>
<span class="tool-help" title="Adds a live rounded mask on the selected layer. Square crops from the center, Rectangle keeps aspect, Circle makes a circular mask. After Apply, tweak CompX Global Roundness in Effect Controls. Undo removes the CompX mask.">?</span>
</div>
<div class="tool-grid tool-grid-3 cx-roundpro-modes">
<button class="tool-btn" type="button" data-rp-mode="square" title="Square matte from the layer center">Square</button>
<button class="tool-btn active" type="button" data-rp-mode="rectangle" title="Keep the layer aspect ratio">Rectangle</button>
<button class="tool-btn" type="button" data-rp-mode="circle" title="Circular matte">Circle</button>
</div>
<div class="cx-flexgrid-fields">
<label class="cx-flexgrid-field"><span>Radius</span><input class="counter-input" id="rp-radius" min="0" max="10000" step="1" type="number" value="150"/></label>
<label class="cx-flexgrid-field"><span>TL</span><input class="counter-input" id="rp-tl" min="0" max="10000" step="1" type="number" value="0" disabled/></label>
<label class="cx-flexgrid-field"><span>TR</span><input class="counter-input" id="rp-tr" min="0" max="10000" step="1" type="number" value="0" disabled/></label>
<label class="cx-flexgrid-field"><span>BL</span><input class="counter-input" id="rp-bl" min="0" max="10000" step="1" type="number" value="0" disabled/></label>
<label class="cx-flexgrid-field"><span>BR</span><input class="counter-input" id="rp-br" min="0" max="10000" step="1" type="number" value="0" disabled/></label>
</div>
<div class="cx-roundpro-toggles">
<label class="layer-match-toggle" title="Use one radius for every corner"><input id="rp-uniform" type="checkbox" checked/> Link corners</label>
<label class="layer-match-toggle" title="Scale the radius to each layer's size"><input id="rp-consistent" type="checkbox" checked/> Consistent size</label>
</div>
<div class="tool-grid tool-grid-2">
<button class="tool-btn primary" id="btnRoundProApply" type="button" title="Apply the rounded matte to selected layers">Apply</button>
<button class="tool-btn" id="btnRoundProUndo" type="button" title="Remove the CompX Round Pro mask from selected layers">Undo</button>
</div>
<button class="tool-btn" id="btnRoundProFit" type="button" title="Fit selected layers to the composition">Fit to Comp</button>
<p class="hint cx-flexgrid-help">Footage and solids get a rounded mask; shape rectangles keep their fill and use native roundness when corners are linked. Unlink corners for per-corner control. Tweak CompX Global Roundness in Effect Controls.</p>
</div>
<div class="tool-section" id="toolkitShapeSourceSection">
<div class="tool-section-head">
<div class="tool-section-title">🎨 SHAPE TOOLKIT</div>
<span class="tool-help" title="Select one or more Shape Layers, then click to add After Effects shape operators, line-style presets, or one-click motion presets.">?</span>
</div>
<div class="shape-toolkit" id="shapeToolkit">
<div class="tool-subgroup shape-subgroup">
<div class="tool-subgroup-title">WORKFLOW</div>
<div class="counter-row"><select class="counter-select" id="shapeTargetMode" title="Choose where Shape Toolkit operations are applied"><option value="auto">Target: Auto</option><option value="selected">Selected Group</option><option value="layer">Entire Layer</option></select><input class="counter-input small" id="shapeDurationFrames" min="1" max="300" type="number" value="24" title="Animation duration in frames for Motion presets and animated Fine Controls"/><select class="counter-select" id="shapeEaseMode" title="Easing for Motion presets and animated Fine Controls"><option value="smooth">Smooth</option><option value="snappy">Snappy</option><option value="linear">Linear</option></select></div>
<div class="hint">Auto targets the selected Shape Group, or the whole layer when no group is selected. Duration controls Motion timing; Ease affects keyframed tools. Alt-click adds a new modifier copy.</div>
</div>
<div class="tool-subgroup shape-subgroup">
<div class="tool-subgroup-title">OPERATORS</div>
<div class="tool-grid tool-grid-3">
<button class="tool-btn" data-shape-op="trim" title="Add Trim Paths">✂ Trim</button>
<button class="tool-btn" data-shape-taper="end" title="Taper the end of every targeted stroke">➤ Taper End</button>
<button class="tool-btn" data-shape-taper="both" title="Taper both ends of every targeted stroke">◆ Taper Both</button>
<button class="tool-btn" data-shape-op="dashes" title="Add Dashes to stroke">┊ Dashes</button>
<button class="tool-btn" data-shape-op="offset" title="Add Offset Paths">◒ Offset</button>
<button class="tool-btn" data-shape-op="repeater" title="Add Repeater">❖ Repeater</button>
<button class="tool-btn" data-shape-op="zigzag" title="Add Zig Zag">〰 Zig Zag</button>
<button class="tool-btn" data-shape-op="twist" title="Add Twist">🌀 Twist</button>
<button class="tool-btn" data-shape-op="round" title="Add Round Corners">⌒ Round</button>
<button class="tool-btn" data-shape-op="pucker" title="Add Pucker &amp; Bloat">◑ Pucker</button>
<button class="tool-btn" data-shape-op="wigglePaths" title="Add Wiggle Paths (Roughen)">〰 Wig Path</button>
<button class="tool-btn" data-shape-op="wiggleTransform" title="Add Wiggle Transform">⤨ Wig Xf</button>
<button class="tool-btn" data-shape-op="merge" title="Add Merge Paths">⧉ Merge</button>
<button class="tool-btn" data-shape-op="fill" title="Add Fill">■ Fill</button>
<button class="tool-btn" data-shape-op="stroke" title="Add Stroke">▢ Stroke</button>
</div>
</div>
<div class="tool-subgroup shape-subgroup">
<div class="tool-subgroup-title">LINE PRESETS</div>
<div class="tool-grid tool-grid-3">
<button class="tool-btn" data-shape-preset="lightning" title="Stroke → Trim (write-on) → Taper → Dashes">⚡ Lightning</button>
<button class="tool-btn" data-shape-preset="social" title="Stroke + Trim + Round Cap + Small Taper">● Social</button>
<button class="tool-btn" data-shape-preset="arrow" title="Trim + Taper (End Width 0)">➤ Arrow</button>
<button class="tool-btn" data-shape-preset="signature" title="Trim Paths + Round Stroke + Easy Ease">✍ Signature</button>
<button class="tool-btn" data-shape-preset="road" title="Dashes + animated offset">🛣 Road</button>
</div>
</div>
<div class="tool-subgroup shape-subgroup">
<div class="tool-subgroup-title">MOTION</div>
<div class="tool-grid tool-grid-3">
<button class="tool-btn" data-shape-preset="drawLine" title="Write-on: Trim End 0→100 with easy ease">✏ Draw</button>
<button class="tool-btn" data-shape-preset="eraseLine" title="Erase: Trim Start 0→100">▱ Erase</button>
<button class="tool-btn" data-shape-preset="loadingCircle" title="Spinning trimmed segment">◌ Loader</button>
<button class="tool-btn" data-shape-preset="spinner" title="Rotation loop + trim">✷ Spinner</button>
<button class="tool-btn" data-shape-preset="loadingBar" title="Trim End 0→100 looping">▭ Bar</button>
<button class="tool-btn" data-shape-preset="arrowDraw" title="Arrow + write-on">➹ Arrow Draw</button>
</div>
</div>
<div class="tool-subgroup shape-subgroup">
<div class="tool-subgroup-title">FINE CONTROLS</div>
<div class="tool-grid tool-grid-3">
<button class="tool-btn" data-shape-ctrl="trim" title="Open Trim Paths controls (sliders + quick presets)">✂ Trim…</button>
<button class="tool-btn" data-shape-ctrl="taper" title="Open Taper controls (sliders + presets)">📏 Taper…</button>
<button class="tool-btn" data-shape-ctrl="dashes" title="Open Dashes controls (sliders)">┊ Dashes…</button>
</div>
</div>
<div class="tool-subgroup shape-subgroup">
<div class="tool-subgroup-title">REMOVE &amp; RESET</div>
<div class="tool-grid tool-grid-3"><button class="tool-btn" data-shape-reset="trim" title="Remove Trim Paths from the target">Remove Trim</button><button class="tool-btn" data-shape-reset="dashes" title="Remove all dash and gap entries from targeted strokes">Remove Dashes</button><button class="tool-btn" data-shape-reset="stroke" title="Reset targeted stroke width, caps, opacity, dashes, and taper">Reset Stroke</button></div>
</div>
</div>
</div>
</div>
 </div>
</div>
<!-- ═══════════════════════════════════════════════════════════════════
     ORBIT 3D PANEL — Camera, 2D to 3D, Mesh primitives
     ═══════════════════════════════════════════════════════════════════ -->
<div class="app-panel" id="panel-advanced">
<div class="tools-scroll">
<div class="tool-section cx-camera-card cx3d-panel" id="cxCamera3D">
  <div class="cx3d-header">
    <div class="cx3d-brand"><span class="cx3d-brand-icon" aria-hidden="true">&#9678;</span><div><strong>ORBIT 3D</strong><small>Camera · Extrude · Mesh</small></div></div>
    <div class="cx3d-header-actions"><span class="cx-feature-status" id="cxCameraStateBadge" role="status" aria-live="polite">NOT SET</span><button id="btn3DRigClean" class="cx3d-icon-btn danger" title="Clean all 3D rig layers and controllers" aria-label="Clean all 3D rigs">&#9003;</button></div>
  </div>
  <div class="cx-camera-workflow cx3d-workflow">
    <div class="cx3d-rig-lens">
      <label class="cx3d-rig-select"><span>MOVE</span><select id="cxCameraMoveMode" class="cx-select" title="Camera move"><option value="orbitLeft">Orbit Left</option><option value="orbitRight">Orbit Right</option><option value="orbitUp">Orbit Up</option><option value="orbitDown">Orbit Down</option><option value="truckLeft">Truck Left</option><option value="truckRight">Truck Right</option><option value="forward">Push In</option><option value="backward">Pull Out</option><option value="panLeft">Pan Left</option><option value="panRight">Pan Right</option><option value="tiltUp">Tilt Up</option><option value="tiltDown">Tilt Down</option></select></label>
      <div class="cx3d-lens-control"><span>LENS</span><input id="cxCameraLens" class="cx-input" type="number" min="1" max="500" value="24" title="Camera focal length in millimeters"><div class="cx3d-lens-chips" aria-label="Lens presets"><button type="button" data-camera-lens="18">18</button><button type="button" class="active" data-camera-lens="24">24</button><button type="button" data-camera-lens="35">35</button><button type="button" data-camera-lens="50">50</button><button type="button" data-camera-lens="85">85</button></div></div>
    </div>
    <div class="cx3d-feature-tiles" aria-label="Camera targeting">
      <button class="cx3d-feature-tile" id="btnCameraTarget" data-camera-action="target"><span class="cx3d-feature-icon">&#9678;</span><b>TARGET</b><small>Follow selected layer</small></button>
      <button class="cx3d-feature-tile" id="btnCameraLookAt" data-camera-action="lookAt"><span class="cx3d-feature-icon">&#9673;</span><b>LOOK AT</b><small>Snap to selection</small></button>
      <button class="cx3d-feature-tile" id="btnCameraAutoFocus" data-camera-action="autoFocus"><span class="cx3d-feature-icon">&#10022;</span><b>AUTO FOCUS</b><small>Track focus distance</small></button>
    </div>
    <div class="cx3d-shot-row"><span>SHOT</span><div class="cx3d-segmented" role="group" aria-label="Shot size"><button class="cx3d-btn" data-camera-frame="wide">WIDE</button><button class="cx3d-btn active" data-camera-frame="medium">MEDIUM</button><button class="cx3d-btn" data-camera-frame="close">CLOSE</button></div></div>
    <div class="cx-camera-number-grid cx-camera-number-grid-2 cx3d-move-fields"><label>DISTANCE<input id="cxCameraDistance" class="cx-input" type="number" min="1" max="100000" step="10" value="500"></label><label>FRAMES<input id="cxCameraDuration" class="cx-input" type="number" min="1" max="300" value="24"></label></div>
    <div class="cx3d-primary-row"><button class="cx3d-btn cx3d-secondary" data-camera-action="setup"><span>&#11041;</span><b>SETUP</b><small>Create camera rig</small></button><button class="cx3d-btn cx3d-animate" data-camera-action="move"><span>&#8767;</span><b>ANIMATE</b><small>Keyframe the move</small></button><button class="cx3d-btn cx3d-secondary" id="cxCameraDOF" data-camera-action="dof" aria-pressed="false"><span>&#9673;</span><b>DOF</b><small>Depth of field</small></button></div>
    <div class="cx3d-utility-row"><button class="cx3d-btn" data-camera-action="reset">&#8635; RESET</button><button class="cx3d-btn danger" data-camera-action="unrig">&#9003; UNRIG</button></div>
  </div>
  <section class="cx3d-quick-tools cx3d-super" id="cx3dConvertTools">
    <h3>2D → 3D <label class="cx3d-mesh-depth">DEPTH <input id="cxMeshExtrudeDepth" max="800" min="4" step="4" type="number" value="80" title="Extrusion depth in pixels"/></label></h3>
    <p class="cx3d-super-hint">Select a shape or text layer for Extrude. For Path → 3D, select the Path in the timeline first.</p>
    <div class="cx3d-quick-grid cx3d-quick-grid-2">
      <button class="cx3d-btn" id="btn3DMeshExtrude" type="button" title="Turn the selected shape or text layer into extruded 3D"><span>&#9650;</span><b>EXTRUDE</b><small>Selected shape / text</small></button>
      <button class="cx3d-btn" id="btn3DMeshPathExtrude" type="button" title="Select a mask or shape path, then build a 3D extruded shape from it"><span>&#10548;</span><b>PATH → 3D</b><small>Selected path only</small></button>
    </div>
  </section>
  <section class="cx3d-quick-tools" id="cx3dMeshTools">
    <h3>CREATE</h3>
    <div class="cx3d-quick-grid">
      <button class="cx3d-btn" id="btn3DMeshCube" type="button" title="Create an extruded 3D cube"><span>&#9635;</span><b>CUBE</b><small>Native 3D shape</small></button>
      <button class="cx3d-btn" id="btn3DMeshPlane" type="button" title="Create a 3D plane"><span>&#9638;</span><b>PLANE</b><small>Flat 3D surface</small></button>
      <button class="cx3d-btn" id="btn3DMeshCylinder" type="button" title="Create an extruded 3D cylinder"><span>&#9678;</span><b>CYLINDER</b><small>Native 3D shape</small></button>
      <button class="cx3d-btn" id="btn3DMeshSphere" type="button" title="Create a rounded 3D sphere"><span>&#9679;</span><b>SPHERE</b><small>Beveled 3D disc</small></button>
      <button class="cx3d-btn" id="btn3DMeshImport" type="button" title="Import a GLB or GLTF model into the active composition"><span>&#9651;</span><b>IMPORT GLB</b><small>GLB / GLTF file</small></button>
      <button class="cx3d-btn" id="btn3DMeshEnvLight" type="button" title="Add an environment light for native 3D"><span>&#9728;</span><b>ENV LIGHT</b><small>Light the scene</small></button>
    </div>
  </section>
  <section class="cx3d-quick-tools" id="cx3dSceneTools">
    <h3>SCENE</h3>
    <div class="cx3d-quick-grid">
      <button class="cx3d-btn" id="btn3DRigLight" type="button" title="Add a 3-point orbit light rig"><span>&#9728;</span><b>LIGHT RIG</b><small>3-point lights</small></button>
      <button class="cx3d-btn" id="btn3DRigFloor" type="button" title="Add a 3D ground plane"><span>&#9638;</span><b>FLOOR</b><small>Ground &amp; shadows</small></button>
      <button class="cx3d-btn" id="btn3DRigStacker" type="button" title="Spread selected layers in Z depth"><span>&#9636;</span><b>STACK</b><small>Z-depth layers</small></button>
    </div>
  </section>
  <div class="cx-feature-status cx3d-footer-status" id="cxCameraStatus" role="status" aria-live="polite">Open a comp, then Setup the camera rig — or extrude a shape.</div>
</div>


</div>
<div class="hint" id="advancedHint" role="status" aria-live="polite">Advanced tools ready.</div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════
     MOTION LAB PANEL — Curve Lab, Orbit Bounce
     ═══════════════════════════════════════════════════════════════════ -->
<div class="app-panel" id="panel-pro">
<div class="tools-scroll">

<div class="tool-section cx-graph-card" id="cxGraphCardWrap"><div id="cxFlow20"></div></div>

<div class="tool-section cx-graph-card cx-flex-bounce-card" id="cxFlexBounceCard">
  <div class="fx20-topbar">
    <div class="fx20-titleblock">
      <div class="fx20-title"><span class="fx20-kicker"></span><strong>ORBIT BOUNCE</strong></div>
      <div class="fx20-subtitle">Spring after the last keyframe — Amplitude / Frequency / Damping</div>
    </div>
  </div>
  <div class="fxb-canvas-wrap"><canvas id="fxbCanvas" width="500" height="140" aria-label="Bounce curve preview"></canvas></div>
  <div class="fxb-sliders">
    <label class="fxb-row"><span>AMPLITUDE</span><input id="fxbAmp" type="range" min="0" max="40" step="1" value="20"/><b id="fxbAmpVal">20</b></label>
    <label class="fxb-row"><span>FREQUENCY</span><input id="fxbFreq" type="range" min="0" max="20" step="0.1" value="2"/><b id="fxbFreqVal">2</b></label>
    <label class="fxb-row"><span>DAMPING</span><input id="fxbDamp" type="range" min="0" max="15" step="0.1" value="4"/><b id="fxbDampVal">4</b></label>
  </div>
  <div class="fx20-actions">
    <button type="button" id="fxbReset">RESET</button>
    <button type="button" id="fxbRemove">REMOVE</button>
  </div>
  <button type="button" id="fxbApply" class="fx20-apply">✓ APPLY BOUNCE</button>
  <div class="fx20-status" id="fxbStatus">Select a keyframed Timeline property, then Apply.</div>
</div>

</div>
</div>

<div class="app-panel" id="panel-tracker">
<div class="tracker-scroll">
<div class="tracker-status-card">
<div class="tracker-dot nocomp" id="trackerDot"></div>
<div class="tracker-status-text-wrap">
<div class="tracker-status-text" id="trackerStatusText">Connecting…</div>
<div class="tracker-comp-name" id="trackerCompName"></div>
</div>
</div>
<div class="tracker-ring-card">
<div class="tracker-streak-time" id="trackerStreakTime">00:00</div>
<div class="tracker-streak-label">of <span id="trackerIntervalLabel">20:00</span> work streak</div>
<div class="tracker-progress-track"><div class="tracker-progress-fill" id="trackerProgressFill"></div></div>
</div>
<div class="tracker-break-banner" id="trackerBreakBanner" style="display:none;">
<div class="tracker-break-msg">👁 20 min continuous work — time for an eye break</div>
<button class="tool-btn wide primary" id="btnStartBreak">Start 20s Eye Break</button>
<button class="tool-btn wide" id="btnSkipBreak" style="margin-top:4px;">⏩ Skip Break</button>
</div>
<div class="tracker-total-row">
<div class="tracker-total-box">
<div class="tracker-total-label">TODAY</div>
<div class="tracker-total-value" id="trackerTodayTotal">00:00:00</div>
</div>
<button class="tool-btn" id="btnResetToday">Reset Today</button>
</div>
<div class="tool-section">
<div class="tool-section-head">
<div class="tool-section-title">📅 HISTORY</div>
</div>
<div class="tracker-total-row" style="margin-bottom:8px;">
<div class="tracker-total-box">
<div class="tracker-total-label">LAST 7 DAYS</div>
<div class="tracker-total-value" id="trackerWeekTotal">00:00:00</div>
</div>
</div>
<div class="studio-list" id="trackerHistoryList">
<div class="studio-empty">No past days tracked yet — history fills in once today rolls over to tomorrow.</div>
</div>
</div>
<div class="tool-section tracker-workspace">
<div class="tool-section-head"><div class="tool-section-title">✅ TODO & NOTES</div><span class="tracker-word-count" id="trackerNoteCount">0 / 500 words</span></div>
<div class="tracker-todo-add"><input class="counter-input" id="trackerTodoInput" maxlength="160" placeholder="Add a task and press Enter…"/><button class="tool-btn primary" id="btnTrackerTodoAdd">Add</button></div>
<div class="tracker-todo-list" id="trackerTodoList"></div>
<textarea class="studio-textarea tracker-notes" id="trackerNotes" maxlength="3500" rows="5" placeholder="Project notes — saved locally in this panel (up to 500 words)."></textarea>
<div class="hint">Tasks and notes are stored locally and stay available after restarting the panel.</div>
</div>
<div class="tool-section">
<div class="tool-section-title">⚙ SETTINGS</div>
<div class="tracker-setting-row">
<span class="tracker-setting-label">Work interval (min)</span>
<input class="counter-input small" id="settingWorkInterval" max="120" min="1" type="number" value="20"/>
</div>
<div class="tracker-setting-row">
<span class="tracker-setting-label">Idle threshold (sec)</span>
<input class="counter-input small" id="settingIdleThreshold" max="300" min="10" type="number" value="45"/>
</div>
<div class="tracker-note">Idle threshold = how long without activity before the timer pauses.</div>
</div>
</div>
</div>
<div class="app-panel" id="panel-colors">
<div class="tools-scroll">
  <div class="cx-colors-legacy">
  <div class="cx-color-head">
  <strong>CUSTOM COLORS</strong>
  <span>Pick, apply and organize colors for your comp</span>
  </div>
  <!-- Color Picker -->
  <div class="cx-color-card">
  <div class="cx-color-card-head">
  <span class="cx-color-card-icon" aria-hidden="true">🎨</span>
  <div class="cx-color-card-title">COLOR PICKER</div>
  <button class="tool-help" data-obs type="button" title="Pick a color from the selected layer or choose manually. Apply to selected layers." aria-label="About the Color Picker">?</button>
  </div>
  <div class="cx-color-pick-row">
  <input id="colorPickerMain" type="color" value="#ff6600" title="Pick a color"/>
  <input class="counter-input cx-color-hex" id="colorHexInput" placeholder="#ff6600" type="text" value="#ff6600" spellcheck="false"/>
  <button class="cx-eyedropper-btn cx-btn-icon" data-obs id="btnScreenEyedropper" type="button" title="Click, then pick a pixel from any image, video, Composition or screen area">⌾</button>
  <button class="cx-btn" data-obs id="btnColorPickFromLayer" type="button" title="Pick color from selected layer's fill/solid">Pick</button>
  </div>
  <div class="cx-eyedropper-status" id="colorEyedropperStatus">⌾ Screen picker ready · click anywhere to sample</div>
  <!-- RGB & HSL inputs -->
  <div class="cx-color-fields">
  <div class="cx-color-fields-row">
  <label><span>R</span><input class="counter-input" id="colorRInput" type="number" min="0" max="255" placeholder="R"/></label>
  <label><span>G</span><input class="counter-input" id="colorGInput" type="number" min="0" max="255" placeholder="G"/></label>
  <label><span>B</span><input class="counter-input" id="colorBInput" type="number" min="0" max="255" placeholder="B"/></label>
  </div>
  <div class="cx-color-fields-row">
  <label><span>H</span><input class="counter-input" id="colorHInput" type="number" min="0" max="360" placeholder="H"/></label>
  <label><span>S%</span><input class="counter-input" id="colorSInput" type="number" min="0" max="100" placeholder="S%"/></label>
  <label><span>L%</span><input class="counter-input" id="colorLInput" type="number" min="0" max="100" placeholder="L%"/></label>
  </div>
  </div>
  <div class="cx-color-actions">
  <button class="cx-btn cx-btn-primary" data-obs id="btnColorApplyFill" type="button">Apply Fill</button>
  <button class="cx-btn" data-obs id="btnColorApplySolid" type="button">Apply to Solid</button>
  <button class="cx-btn" data-obs id="btnColorSaveSwatch" type="button">Save Swatch</button>
  </div>
  </div>
  <!-- Recent Colors -->
  <div class="cx-color-card">
  <div class="cx-color-card-head">
  <span class="cx-color-card-icon" aria-hidden="true">⏱</span>
  <div class="cx-color-card-title">RECENT COLORS</div>
  <button class="cx-color-clear" data-obs id="btnClearRecent" type="button">CLEAR</button>
  </div>
  <div class="swatch-grid" id="recentColorGrid">
  <div class="studio-empty">No recent colors.</div>
  </div>
  </div>
  <!-- Swatches -->
  <div class="cx-color-card">
  <div class="cx-color-card-head">
  <span class="cx-color-card-icon" aria-hidden="true">🔖</span>
  <div class="cx-color-card-title">SWATCHES</div>
  <button class="cx-color-clear" data-obs id="btnClearSwatches" type="button">CLEAR</button>
  <button class="tool-help" data-obs type="button" title="Saved colors. Click to load/copy, double-click to apply, or use the x button to remove." aria-label="About swatches">?</button>
  </div>
  <div class="swatch-grid" id="swatchGrid">
  <div class="studio-empty">No swatches saved yet. Pick a color and click "Save Swatch".</div>
  </div>
  </div>
  <!-- My Palettes -->
  <div class="cx-color-card">
  <div class="cx-color-card-head">
  <span class="cx-color-card-icon" aria-hidden="true">🎨</span>
  <div class="cx-color-card-title">MY PALETTES</div>
  <button class="cx-btn cx-btn-mini" data-obs id="btnNewPalette" type="button">+ New</button>
  </div>
  <div id="paletteList">
  <div class="studio-empty">No custom palettes yet.</div>
  </div>
  </div>
  <!-- Gradient Builder -->
  <div class="cx-color-card cx-gradient-builder">
  <div class="cx-color-card-head">
  <span class="cx-color-card-icon" aria-hidden="true">🌈</span>
  <div class="cx-color-card-title">GRADIENT BUILDER</div>
  <button class="tool-help" data-obs type="button" title="Build a 2-stop Ramp or 4-stop gradient, preview it live, save it, and apply it to selected layers." aria-label="About the Gradient Builder">?</button>
  </div>
  <div class="cx-gradient-preview" id="customGradientPreview"><span id="customGradientLabel">2 stops · 0°</span></div>
  <div class="counter-row cx-gradient-stops" style="margin-bottom:6px;gap:6px;">
  <label title="Start color"><span>1</span><input id="gradColor1" type="color" value="#EA2A2A"/><button class="cx-stop-eyedropper" data-eyedrop-target="gradColor1" type="button" title="Pick Stop 1 from the screen">⌾</button></label>
  <label title="Second color"><span>2</span><input id="gradColor2" type="color" value="#D1511A"/><button class="cx-stop-eyedropper" data-eyedrop-target="gradColor2" type="button" title="Pick Stop 2 from the screen">⌾</button></label>
  <label class="grad-extra-stop" title="Third color"><span>3</span><input id="gradColor3" type="color" value="#7C3AED"/><button class="cx-stop-eyedropper" data-eyedrop-target="gradColor3" type="button" title="Pick Stop 3 from the screen">⌾</button></label>
  <label class="grad-extra-stop" title="Fourth color"><span>4</span><input id="gradColor4" type="color" value="#22D3EE"/><button class="cx-stop-eyedropper" data-eyedrop-target="gradColor4" type="button" title="Pick Stop 4 from the screen">⌾</button></label>
  </div>
  <div class="counter-row cx-color-grad-options" style="margin-bottom:6px;">
  <select class="counter-input" id="gradStopMode">
  <option value="2">2 Stops</option>
  <option value="4">4 Stops</option>
  </select>
  <select class="counter-input" id="gradType">
  <option value="1">Linear</option>
  <option value="2">Radial</option>
  </select>
  <input class="counter-input" id="gradAngle" type="number" min="-360" max="360" placeholder="Angle" value="0" title="Gradient angle"/>
  </div>
  <div class="cx-color-actions" style="margin-bottom:6px;">
  <button class="cx-btn" data-obs id="btnGradientSwap" type="button" title="Reverse the color order">⇄ Swap</button>
  <button class="cx-btn" data-obs id="btnGradientHarmony" type="button" title="Generate a balanced gradient from the current first color">✦ Harmony</button>
  <button class="cx-btn" data-obs id="btnSaveGradient" type="button" title="Save this gradient variant">＋ Save</button>
  </div>
  <button class="cx-btn cx-btn-primary cx-btn-wide" data-obs id="btnApplyCustomGrad" type="button">Apply Gradient</button>
  <div class="cx-gradient-saved-head"><span>SAVED VARIANTS</span><button class="cx-btn cx-btn-mini" data-obs id="btnScanColorDuplicates" type="button" title="Scan saved and built-in colors/gradients for duplicates">Scan duplicates</button></div>
  <div class="cx-gradient-saved" id="savedGradientGrid"><div class="studio-empty">No saved gradients yet.</div></div>
  <div class="cx-color-audit" id="colorDuplicateStatus">Duplicate scan ready.</div>
  </div>
  <!-- Colorplate (Existing Solid/Gradient library renders here) -->
  <details class="cx-color-card cx-library-details" open>
  <summary class="cx-library-head">
  <span class="cx-color-card-icon" aria-hidden="true">📚</span>
  <span class="cx-color-card-title">COLOR LIBRARY</span>
  <span class="cx-library-sub">SaaS · Marketing · Warm · 2-Color · 4-Color</span>
  <span class="cx-library-caret" aria-hidden="true">▾</span>
  </summary>
  <div class="cx-library-body">
  <div id="cxColorPlate"></div>
  </div>
  </details>
  </div><!--/cx-colors-legacy-->
</div>
</div>
<div class="app-panel" id="panel-comps">
<div id="compositionLibraryView" aria-label="Composition Library">
  <div class="compx-comp-toolbar"><input id="compxCompPath" readonly placeholder="Composition storage folder…"/><button id="btnCompxCompBrowse">Browse</button><button id="btnCompxCompRefresh" title="Refresh">↻</button><button class="primary" id="btnCompxCompAdd" title="Save active After Effects composition to library">+ Add to Comp</button><button id="btnCompxCompTheme" title="Switch Comp Saver theme" aria-label="Switch Comp Saver theme">Theme</button></div>
  <div class="compx-comp-filter"><input id="compxCompSearch" placeholder="Search compositions…" type="text"/><label>Card size <input id="compxCompSize" min="90" max="220" step="5" type="range" value="140"/></label><span id="compxCompCount">0</span></div>
  <div class="compx-comp-categories" id="compxCompCategories"></div>
  <div class="compx-comp-bulk"><span id="compxCompSelected">0 selected</span><input id="compxCompCategoryInput" placeholder="Category name…" type="text"/><button class="primary" id="btnCompxCompApplyCategory">Apply</button><button class="compx-bulk-delete" id="btnCompxCompBulkDelete" title="Delete selected compositions">⌫</button><button id="btnCompxCompClearSelection">Clear</button></div>
  <div class="compx-comp-grid" id="compxCompGrid"></div>
</div>

<!-- ═══════════════════════════════════════════
     COMP SAVER — Add to Library Modal
     Lives inside #panel-comps so theme vars apply
     ═══════════════════════════════════════════ -->
<div class="compx-add-backdrop" id="compxAddModal" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="compxAddModalTitle">
  <div class="compx-add-box">
    <div class="compx-add-header">
      <span id="compxAddModalTitle">Add to Library</span>
      <button class="compx-add-close" id="btnCompxAddClose" title="Close" type="button">×</button>
    </div>
    <div class="compx-add-body">
      <p class="compx-add-subtitle">Rename comp &amp; assign a category.</p>

      <div class="compx-add-field">
        <label class="compx-add-label" for="compxAddName">Comp Name</label>
        <input class="compx-add-input" id="compxAddName" type="text" placeholder="comp_name" autocomplete="off"/>
      </div>

      <div class="compx-add-field">
        <label class="compx-add-label" for="compxAddCatSelect">Existing Category</label>
        <select class="compx-add-input compx-add-select" id="compxAddCatSelect">
          <option value="">— No category —</option>
        </select>
      </div>

      <div class="compx-add-field">
        <label class="compx-add-label" for="compxAddNewCat">Or Create New Category</label>
        <input class="compx-add-input" id="compxAddNewCat" type="text" placeholder="e.g. own-ui" autocomplete="off"/>
      </div>
    </div>
    <div class="compx-add-footer">
      <button class="compx-add-btn-cancel" id="btnCompxAddCancel" type="button">Cancel</button>
      <button class="compx-add-btn-confirm primary" id="btnCompxAddConfirm" type="button">
        <span id="compxAddBtnLabel">+ Add Comp</span>
      </button>
    </div>
  </div>
</div>

</div>
<div class="app-panel" id="panel-sfx">
<div class="asset-type-row" id="assetTypeRow" aria-label="Library types">
<button class="shelf" data-type="mogrt" title="MOGRT"><span>MOGRT</span></button>
<button class="shelf" data-type="textanim" title="Text Animation"><span>TEXT</span></button>
<button class="shelf" data-type="motions" title="Motion presets"><span>MOTIONS</span></button>
<button class="shelf active" data-type="sfx" title="Sound Effects"><span>SFX</span></button>
<button class="shelf" data-type="ffx" title="FFX Presets"><span>FFX</span></button>
</div>
<div id="sfxMogrtView" aria-label="Drop SFX or MOGRT files and folders anywhere in this library">
<div class="library-filter-strip">
<div class="search-row"><input id="search" placeholder="Search assets…" type="text"/></div>
<div class="tabs-row" id="tabsRow">
<button class="tab active" data-view="all">All Files</button>
<button class="tab" data-view="favorites" title="Show favorite-marked assets">Favorites</button>
</div>
<div class="controls-group">
<select class="select-control" id="sortBy">
<option value="name">Sort: Name</option>
<option value="duration">Sort: Duration</option>
</select>
</div>
</div>
<div class="lib-toolbar">
<div class="lib-status-bar">
<span class="lib-item-count" id="libItemCount">0 items</span>
<div class="lib-status-actions">
<div class="lib-view-toggle" title="View mode">
<button class="lib-view-btn active" id="btnGridView" title="Grid view">▦</button>
<button class="lib-view-btn" id="btnListView" title="List view">☰</button>
</div>
<button class="lib-status-btn" id="btnRefreshView" title="Refresh library">↻</button>
</div>
</div>
<div class="library-action-strip">
<div class="actions-row">
<button class="btn primary compact-icon-btn" id="btnAddFiles" title="Add files · or drag and drop into the library">+</button>
<button class="btn compact-icon-btn" id="btnAddFolder" title="Import folder · or drag and drop into the library">F</button>
<button class="btn compact-icon-btn" id="btnRemoveMarkedSfx" title="Remove marked files or marked folders from the library">✕★</button>
<button class="btn compact-icon-btn" id="btnCheckMissing" title="Check missing files">!</button>
<button class="btn compact-icon-btn" id="btnRelinkLibrary" title="Relink missing files">L</button>
<div class="mixer-wrap mixer-top-wrap">
<button class="btn mixer-toggle" id="btnMixer" title="Volume" aria-label="Volume"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 10v4h4l5 4V6L8 10H4z"></path><path d="M16 9c1.3 1.5 1.3 4.5 0 6M19 6c3 3.2 3 8.8 0 12"></path></svg></button>
<button class="btn mixer-toggle" id="btnPitch" title="Pitch" aria-label="Pitch"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 15c3-7 5 3 8-5s5 3 8-5"></path><path d="M18 4v5M16 6h4"></path></svg></button>
<div class="mixer-popover" id="mixerPopover" style="display:none;">
<div class="slider-block" id="volumeBlock">
<div class="slider-label"><span>VOLUME</span><span class="val" id="volumeVal">100%</span></div>
<input id="volume" max="200" min="0" step="1" type="range" value="100"/>
</div>
<div class="slider-block" id="pitchBlock">
<div class="slider-label"><span>PITCH</span><span class="val" id="pitchVal">0 st</span></div>
<input id="pitch" max="12" min="-12" step="1" type="range" value="0"/>
</div>
</div>
</div>

<div hidden aria-hidden="true">
<button id="btnBatchMode" type="button"></button><button id="btnReset" type="button"></button>
<button id="btnBackupLibrary" type="button"></button><button id="btnRestoreLibrary" type="button"></button>
<span id="mogrtCacheInfo"></span><button id="btnClearMogrtCache" type="button"></button>
<button id="btnCopyDiagnostics" type="button"></button><span id="diagnosticSummary"></span>
</div>

</div>
<div class="card-size-row" title="Resize the sound cards">
<span class="card-size-icon">▪</span>
<input id="cardSizeSlider" max="220" min="90" step="5" type="range" value="130"/>
<span class="card-size-icon big">▪</span>
</div>
