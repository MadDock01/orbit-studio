<label class="cx-cap-field"><span>Alignment</span><select class="counter-select" id="flexCaptionPosition"><option value="bottom">Bottom</option><option value="center">Center</option><option value="top">Top</option></select></label>
<label class="cx-cap-field"><span>Animation</span><select class="counter-select" id="flexCaptionAnimType"><option value="pop">Pop</option><option value="whip">Whip</option><option value="scale">Scale</option><option value="bounce">Bounce</option><option value="elastic">Elastic</option><option value="drop">Drop</option><option value="slideUp">Slide Up</option><option value="slideLeft">Slide Left</option><option value="slideRight">Slide Right</option><option value="rotate">Rotate</option><option value="blurIn">Blur In</option><option value="fade">Fade</option><option value="letterRise">Letter Rise</option><option value="none">None</option></select></label>
</div>
</div>
