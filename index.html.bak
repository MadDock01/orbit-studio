<button data-rule-color="#ffe600" style="background:#ffe600" title="Yellow"></button>
<button data-rule-color="#e0303a" style="background:#e0303a" title="Red"></button>
<button data-rule-color="#22ff6f" style="background:#22ff6f" title="Green"></button>
<button data-rule-color="#ff4d8d" style="background:#ff4d8d" title="Pink"></button>
</div>
