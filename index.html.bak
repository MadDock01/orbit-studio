<div class="cx-cap-field cx-simple-font-field"><span>System Font</span><div class="cx-simple-font-combo"><input class="counter-input" id="simpleSrtFontSearch" placeholder="Search fonts..." type="text" title="Type to filter installed fonts" autocomplete="off"/><select class="counter-select" id="simpleSrtFont" title="Installed system fonts detected from After Effects"><option value="">System default</option></select><button id="btnSimpleLoadSystemFonts" type="button" title="Refresh fonts from After Effects" aria-label="Refresh system fonts">&#8635;</button></div><datalist id="simpleSystemFontList"></datalist><small id="simpleSystemFontStatus" hidden>Reading fonts from After Effects...</small></div>
