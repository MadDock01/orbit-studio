<label class="org-check"><input checked="" id="orgOptEmpty" type="checkbox"/> Remove Empty Folders</label>
<label class="org-check org-check-danger"><input id="orgOptUnused" type="checkbox"/> Remove Unused Footage</label>
<label class="org-check org-check-danger"><input id="orgOptMerge" type="checkbox"/> Merge Duplicate Solids</label>
<label class="org-check"><input checked="" id="orgOptGroup" type="checkbox"/> Group by Type</label>
<label class="org-check"><input checked="" id="orgOptLabels" type="checkbox"/> Color Labels</label>
</div>
