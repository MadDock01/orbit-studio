<div class="modal-backdrop" id="shapeModal" style="display:none;">
<div class="modal-box shape-ctrl-box">
<div class="modal-header">
<span id="shapeModalTitle">✂ Trim Paths</span>
<button id="btnShapeClose" title="Close" type="button">×</button>
</div>
<div class="modal-body shape-ctrl-body">
<div class="shape-tabs">
<button class="shape-tab active" data-shape-tab="trim" type="button">✂ Trim</button>
<button class="shape-tab" data-shape-tab="taper" type="button">📏 Taper</button>
<button class="shape-tab" data-shape-tab="dashes" type="button">┊ Dashes</button>
</div>
<div class="shape-panel active" data-shape-panel="trim">
<div class="shape-preset-label">Quick Presets</div>
<div class="shape-preset-row">
<button class="tool-btn" data-trim-preset="writeOn" type="button">Write On</button>
<button class="tool-btn" data-trim-preset="reveal" type="button">Reveal</button>
<button class="tool-btn" data-trim-preset="circleDraw" type="button">Circle Draw</button>
<button class="tool-btn" data-trim-preset="reverseDraw" type="button">Reverse Draw</button>
<button class="tool-btn" data-trim-preset="loop" type="button">Loop</button>
</div>
<div class="shape-custom-label">Custom</div>
<label class="shape-slider"><span>Start</span><input id="trimStart" max="100" min="0" type="range" value="0"/><output id="trimStartV">0</output></label>
<label class="shape-slider"><span>End</span><input id="trimEnd" max="100" min="0" type="range" value="100"/><output id="trimEndV">100</output></label>
<label class="shape-slider"><span>Offset</span><input id="trimOffset" max="360" min="-360" type="range" value="0"/><output id="trimOffsetV">0</output></label>
<label class="shape-check"><input checked="" id="trimAnimate" type="checkbox"/> Animate (write-on)</label>
</div>
<div class="shape-panel" data-shape-panel="taper">
<div class="shape-preset-label">Presets</div>
<div class="shape-preset-row">
<button class="tool-btn" data-taper-preset="arrow" type="button">Arrow</button>
<button class="tool-btn" data-taper-preset="brush" type="button">Brush</button>
<button class="tool-btn" data-taper-preset="needle" type="button">Needle</button>
<button class="tool-btn" data-taper-preset="speedLine" type="button">Speed Line</button>
</div>
<div class="shape-custom-label">Custom</div>
<label class="shape-slider"><span>Start Width</span><input id="taperSW" max="200" min="0" type="range" value="100"/><output id="taperSWV">100</output></label>
<label class="shape-slider"><span>End Width</span><input id="taperEW" max="200" min="0" type="range" value="0"/><output id="taperEWV">0</output></label>
<label class="shape-slider"><span>Start Length</span><input id="taperSL" max="100" min="0" type="range" value="0"/><output id="taperSLV">0</output></label>
<label class="shape-slider"><span>End Length</span><input id="taperEL" max="100" min="0" type="range" value="100"/><output id="taperELV">100</output></label>
<label class="shape-slider"><span>Ease</span><input id="taperEase" max="100" min="0" type="range" value="50"/><output id="taperEaseV">50</output></label>
<div class="shape-note">Taper needs After Effects 2020 or newer.</div>
</div>
<div class="shape-panel" data-shape-panel="dashes">
<div class="shape-custom-label">Dash Pattern</div>
<label class="shape-slider"><span>Dash</span><input id="dashDash" max="200" min="0" type="range" value="12"/><output id="dashDashV">12</output></label>
<label class="shape-slider"><span>Gap</span><input id="dashGap" max="200" min="0" type="range" value="12"/><output id="dashGapV">12</output></label>
<label class="shape-slider"><span>Offset</span><input id="dashOffset" max="360" min="-360" type="range" value="0"/><output id="dashOffsetV">0</output></label>
<label class="shape-check"><input id="dashAnimate" type="checkbox"/> Animate Offset</label>
</div>
</div>
<div class="modal-footer">
<button class="btn" id="btnShapeCancel" type="button">Cancel</button>
<button class="btn primary" id="btnShapeApply" type="button">Apply Custom</button>
</div>
</div>
