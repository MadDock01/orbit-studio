</div>
</div>
<div class="cx-beat-glass-section">
<div class="cx-beat-section-label">Settings</div>
<div class="cx-beat-setting-row"><span id="beatSensitivityTxt">Threshold (sensitivity): 15%</span><input type="range" id="beatSensitivityVal" min="5" max="60" step="1" value="15"/></div>
<div class="cx-beat-setting-inline"><span>Min beat spacing (sec)</span><input type="number" id="beatSpacingVal" min="0.05" max="2" step="0.05" value="0.2"/></div>
<div class="cx-beat-setting-inline"><span>Marker target</span><select id="beatMarkerTarget" class="counter-select" style="flex:0 0 auto;width:160px;"><option value="comp">Composition</option><option value="layer">Selected layer(s)</option></select></div>
</div>
<button class="tool-btn wide primary cx-beat-generate-btn" id="btnGenerateBeatMarkers" type="button">Generate Beat Markers</button>
<div class="hint" id="beatSyncStatus">Select audio in the timeline or choose a local file, then generate markers.</div>
</div>
<div class="modal-footer">
<button class="btn" id="btnBeatSyncClose" type="button">Close</button>
</div>
</div>
</div>
<input accept=".mp3,.wav,.aiff,.aif,.m4a,.aac,.ogg,.mp4,.mov,.mkv,.avi,.webm,audio/*,video/*" id="beatAudioInput" style="display:none" type="file"/>
<div class="modal-backdrop" id="numberCounterModal" style="display:none;" role="dialog" aria-modal="true" aria-labelledby="numberCounterTitle">
<div class="modal-box number-counter-box">
<div class="modal-header"><span id="numberCounterTitle">NUMBER COUNTER</span><button type="button" id="btnNumberCounterClose" aria-label="Close Number Counter">×</button></div>
<div class="modal-body number-counter-body">
<p class="number-counter-description">Create an animated count, or link a layer to its progress.</p>
<div class="counter-row">
<input class="counter-input" id="counterFrom" aria-label="From value" title="From value" placeholder="From" type="number" value="0"/>
<input class="counter-input" id="counterTo" aria-label="To value" title="To value" placeholder="To" type="number" value="100"/>
</div>
<div class="counter-row">
<select class="counter-select" id="counterStyle" title="Number style">
<option value="custom">Custom</option>
<option selected="selected" value="plain">Plain</option>
<option value="comma">Comma</option>
<option value="currency">Currency</option>
<option value="percent">Percent</option>
</select>
<select class="counter-select" id="counterLocale" title="Digit grouping locale">
<option selected="" value="us">US</option>
<option value="eu">EU</option>
<option value="in">IN</option>
<option value="none">None</option>
</select>
<select class="counter-select" id="counterSymbolPos" title="Symbol position (currency / percent styles)">
<option selected="" value="prefix">P</option>
<option value="suffix">S</option>
</select>
</div>
<div class="counter-row" id="counterCustomRow" style="display:none;">
<input class="counter-input small" id="counterDecimals" max="6" min="0" placeholder="Decimals" type="number" value="0"/>
<input class="counter-input" id="counterPrefix" placeholder="Prefix (e.g. $)" type="text"/>
<input class="counter-input" id="counterSuffix" placeholder="Suffix (e.g. %)" type="text"/>
</div>
<button class="tool-btn wide primary" id="btnCreateCounter">Create</button>
<div class="counter-row" style="margin-top:8px;">
<input class="counter-input small" id="counterPosStep" placeholder="px" title="Pixels the selected layer moves (Y) over the full count" type="number" value="12"/>
<button class="tool-btn" id="btnApplyPoz" style="flex:1;" title="Link selected layer Y position to the nearest Number Counter progress">Link Position</button>
</div>
</div>
</div>
</div>

<div class="modal-backdrop" id="explodeModal" style="display:none;">
<div class="modal-box" id="explodeModalBox" style="max-width:300px;">
<div class="modal-header">TEXT EXPLORER</div>
<div class="modal-body">
<div class="modal-message" style="display:block;margin-bottom:12px;">Select one or more text layers. Source layers remain as hidden backups.</div>
<div class="tool-grid tool-grid-2" id="textExploderModes">
<button class="tool-btn" data-text-explode-mode="characters" type="button">Characters</button>
<button class="tool-btn" data-text-explode-mode="words" type="button">Words</button>
<button class="tool-btn" data-text-explode-mode="lines" type="button">Lines</button>
<button class="tool-btn" data-text-explode-mode="paragraphs" type="button">Paragraphs</button>
</div>
</div>
<div class="modal-footer">
<button class="btn" id="explodeModalCancel" type="button">Close</button>
</div>
</div>
</div>

</div>
<div class="cx3d-confirm-backdrop" id="cx3dConfirmBackdrop" hidden>
  <section class="cx3d-confirm-dialog" id="cx3dConfirmDialog" role="alertdialog" aria-modal="true" aria-labelledby="cx3dConfirmTitle" aria-describedby="cx3dConfirmMessage" tabindex="-1">
    <div class="cx3d-confirm-accent" aria-hidden="true"></div>
    <header class="cx3d-confirm-header">
      <span class="cx3d-confirm-icon" id="cx3dConfirmIcon" aria-hidden="true">&#9888;</span>
      <div><small>ORBIT 3D</small><h2 id="cx3dConfirmTitle">Confirm action</h2></div>
      <button type="button" class="cx3d-confirm-close" id="cx3dConfirmClose" aria-label="Close confirmation">&#10005;</button>
    </header>
    <div class="cx3d-confirm-body">
      <p id="cx3dConfirmMessage">Are you sure you want to continue?</p>
      <div class="cx3d-confirm-impact"><span aria-hidden="true">!</span><p id="cx3dConfirmDetail">This operation changes the active composition.</p></div>
    </div>
    <footer class="cx3d-confirm-actions">
      <button type="button" class="cx3d-confirm-cancel" id="cx3dConfirmCancel">CANCEL</button>
      <button type="button" class="cx3d-confirm-accept" id="cx3dConfirmAccept">CONFIRM</button>
    </footer>
  </section>
</div>
<script src="js/CSInterface.js"></script>
<script src="js/diagnostics.js"></script>
<script src="js/storage.js"></script>
<script src="js/compx-license.js?v=65"></script>
<script src="js/compx-loader.js?v=118"></script>
<script src="js/license-gate.js"></script>
<!-- main.js, advanced_features.js, graph20.js, colorplate.js, composition-library.js injected by compx-loader.js after licence verified. -->
</body>
</html>
