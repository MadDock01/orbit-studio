<!DOCTYPE html>

<html>
<head>
<meta charset="utf-8"/>
<meta http-equiv="Content-Security-Policy" content="default-src 'self' data: blob: file:; script-src 'self' 'wasm-unsafe-eval' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: file:; media-src 'self' data: blob: file:; connect-src 'self' https://esiiawfjzmuqplzzdoog.supabase.co https://esiiawfjzmuqplzzdoog.functions.supabase.co http://127.0.0.1:*; object-src 'none'; base-uri 'none'; frame-src 'none'; worker-src 'self' blob:;"/>
<title>Orbit Studio</title>
<link href="css/style.css?v=12" rel="stylesheet"/>
<link href="css/library-visual.css?v=7" rel="stylesheet"/>
<link href="css/graph20.css?v=9" rel="stylesheet"/>
<link href="css/colorplate.css?v=6" rel="stylesheet"/>
<link href="css/orbit-foundation.css?v=6" rel="stylesheet"/>
<link href="css/orbit-shell.css?v=6" rel="stylesheet"/>
<link href="css/orbit-tools.css?v=7" rel="stylesheet"/>
<link href="css/orbit-library.css?v=6" rel="stylesheet"/>
<link href="css/composition-library.css?v=6" rel="stylesheet"/>
<link href="css/orbit-final.css?v=6" rel="stylesheet"/>
<link href="css/orbit-compact.css?v=16" rel="stylesheet"/>
<link href="css/orbit-cards-unified.css?v=6" rel="stylesheet"/>
<link href="css/orbit-console-theme.css?v=10" rel="stylesheet"/>
  <link rel="stylesheet" href="css/license-gate.css?v=5"/>
<link href="css/orbit-redesign.css?v=9" rel="stylesheet"/>
<link href="css/orbit-premium.css?v=11" rel="stylesheet"/>
<link href="css/orbit-exploder.css?v=3" rel="stylesheet"/>
<link href="css/orbit-colors.css?v=2" rel="stylesheet"/>
<link href="css/orbit-library-redesign.css?v=3" rel="stylesheet"/>
<link href="css/orbit-captions.css?v=8" rel="stylesheet"/>
<link href="css/orbit-text-fx.css?v=6" rel="stylesheet"/>
<link href="css/orbit-premium-v2.css?v=10" rel="stylesheet"/>
<link href="css/orbit-dashboard.css?v=10" rel="stylesheet"/>
<link href="css/orbit-modules.css?v=15" rel="stylesheet"/>
</head>
<body>

<!-- ===== CompX license gate (added) ===== -->
<div id="cx-gate" class="cx-gate" hidden>
  <div class="cx-gate__card">

    <div class="cx-gate__brand">
      <div class="cx-gate__mark" aria-hidden="true"><img src="assets/compx-mark.png" alt=""/></div>
      <div>
        <h1 class="cx-gate__title" id="cx-gate-title">Orbit Studio</h1>
        <p class="cx-gate__sub">Creative Control Center</p>
      </div>
    </div>

    <label class="cx-gate__label" for="cx-gate-key">License key</label>
    <input id="cx-gate-key" class="cx-gate__input" type="text"
           placeholder="CX-XXXX-XXXX-XXXX-XXXX" spellcheck="false"
           autocomplete="off" maxlength="29" />

    <p class="cx-gate__msg" id="cx-gate-msg" role="status" aria-live="polite"></p>

    <button id="cx-gate-submit" class="cx-gate__btn" type="button">Activate</button>

    <div class="cx-gate__device">
      <span class="cx-gate__device-dot" aria-hidden="true"></span>
      <span id="cx-gate-device">Detecting device…</span>
    </div>

    <p class="cx-gate__note">
      One license activates one computer. After Effects and Premiere Pro on
      the same machine share a single seat. Need to move to a new computer?
      Release it here or request a reset from your account dashboard
      — device changes are limited to once every 24 hours.
    </p>

    <div class="cx-gate__links">
      <a href="#" id="cx-gate-buy">Buy a license</a>
      <span aria-hidden="true">·</span>
      <a href="#" id="cx-gate-dashboard">My account</a>
      <span aria-hidden="true">·</span>
      <a href="#" id="cx-gate-release">Release this device</a>
    </div>
  </div>
</div>

<!-- Thin banner shown inside the app while running on offline grace -->
<div id="cx-grace" class="cx-grace" hidden>
  <span id="cx-grace-text">Offline mode</span>
  <button type="button" id="cx-grace-retry" class="cx-grace__retry">Reconnect</button>
</div>
<!-- ===== end license gate ===== -->

<!-- Branded release-license confirmation; avoids CEP's native dialog and file-path title. -->
<div class="cx-release-dialog" id="cx-release-dialog" hidden>
  <div class="cx-release-dialog__card" role="dialog" aria-modal="true" aria-labelledby="cx-release-dialog-title" aria-describedby="cx-release-dialog-copy">
    <div class="cx-release-dialog__icon" aria-hidden="true">⇥</div>
    <div class="cx-release-dialog__eyebrow">LICENSE MANAGEMENT</div>
    <h2 id="cx-release-dialog-title">Release this device?</h2>
    <p id="cx-release-dialog-copy">This signs Orbit Studio out on this computer. You can activate another computer immediately.</p>
    <div class="cx-release-dialog__notice">Your next device change will be available after 24 hours.</div>
    <div class="cx-release-dialog__actions">
      <button type="button" class="cx-release-dialog__cancel" id="cx-release-cancel">Keep this device</button>
      <button type="button" class="cx-release-dialog__confirm" id="cx-release-confirm">Release device</button>
    </div>
  </div>
</div>
<!-- New-version notification, shown after the authenticated release check. -->
<div class="cx-update-notice" id="cx-update-notice" hidden role="status" aria-live="polite">
  <div class="cx-update-notice__icon" aria-hidden="true">↑</div>
  <div class="cx-update-notice__content">
    <div class="cx-update-notice__eyebrow">UPDATE AVAILABLE</div>
    <strong>Version <span id="cx-update-version">—</span> is ready</strong>
    <span class="cx-update-notice__copy">Install the latest release to get the newest improvements.</span>
  </div>
  <div class="cx-update-notice__actions">
    <button type="button" class="cx-update-notice__later" id="cx-update-later">Later</button>
    <button type="button" class="cx-update-notice__now" id="cx-update-now">Get update</button>
  </div>
</div>
<div id="app">

<!-- ── Top Title Bar ── -->
<div class="cx-title-bar">
  <div class="cx-header-brand">
    <img class="cx-header-logo" src="assets/compx-mark.png" alt="Orbit Studio logo" width="22" height="22"/>
    <div class="orbit-header-copy">
      <strong>Orbit <span>Studio</span></strong>
      <small>Motion tools for creators</small>
    </div>
  </div><div class="cx-brand-bar">
    <span class="cx-brand-spacer"></span>
    <div class="orbit-host-status"><i></i><span>HOST READY</span></div>


  </div>
</div>

<!-- ── Main Tab Strip ── -->
<div class="cx-app-main">
<nav class="app-tabs-row" id="appTabsRow" aria-label="CompX modules">
<button class="app-tab active" data-apptab="tools" title="Tools"><span class="orbit-tab-icon"><svg viewBox="0 0 20 20"><path d="M4 16 16 4M12.5 3.5l4 4M3.5 12.5l4 4"/></svg></span><span class="orbit-tab-label">Tools</span></button>
<button class="app-tab" data-apptab="studio" title="Studio"><span class="orbit-tab-icon"><svg viewBox="0 0 20 20"><rect x="3" y="3" width="5.5" height="5.5"/><rect x="11.5" y="3" width="5.5" height="5.5"/><rect x="3" y="11.5" width="5.5" height="5.5"/><rect x="11.5" y="11.5" width="5.5" height="5.5"/></svg></span><span class="orbit-tab-label">Studio</span></button>
<button class="app-tab" data-apptab="toolkit" title="Toolkit"><span class="orbit-tab-icon"><svg viewBox="0 0 20 20"><path d="M3 6h14l1 2v8H2V8l1-2Z"/><path d="M7 6V4h6v2M4 10.5h3M13 10.5h3"/></svg></span><span class="orbit-tab-label">Toolkit</span></button>
<button class="app-tab" data-apptab="advanced" title="Orbit 3D"><span class="orbit-tab-icon"><svg viewBox="0 0 20 20"><path d="M2 11h3l2-6 3 11 3-9 2 4h3"/></svg></span><span class="orbit-tab-label">Orbit 3D</span></button>
<button class="app-tab" data-apptab="pro" title="Motion Lab"><span class="orbit-tab-icon"><svg viewBox="0 0 20 20"><rect x="2.5" y="4" width="15" height="12" rx="1"/><path d="m8 7 5 3-5 3Z"/></svg></span><span class="orbit-tab-label">Motion Lab</span></button>
<button class="app-tab" data-apptab="colors" title="Colors"><span class="orbit-tab-icon"><svg viewBox="0 0 20 20"><path d="M10 3a7 7 0 1 0 0 14h1.2a1.6 1.6 0 0 0 0-3.2H10a1.3 1.3 0 0 1 0-2.6h2.5A4.5 4.5 0 0 0 17 6.7C17 4.6 14 3 10 3Z"/><circle cx="6.5" cy="7" r=".8"/><circle cx="9.5" cy="5.8" r=".8"/><circle cx="13" cy="6.7" r=".8"/></svg></span><span class="orbit-tab-label">Colors</span></button>
<button class="app-tab" data-apptab="tracker" title="Tracker"><span class="orbit-tab-icon"><svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="5.5"/><circle cx="10" cy="10" r="1.8"/><path d="M10 1.5V5M10 15v3.5M1.5 10H5M15 10h3.5"/></svg></span><span class="orbit-tab-label">Tracker</span></button>
<button class="app-tab" data-apptab="comps" title="Comp Saver"><span class="orbit-tab-icon"><svg viewBox="0 0 20 20"><path d="M4 2.5h10l2 2V17.5H4Z"/><path d="M7 2.5v5h6v-5M7 17.5v-6h6v6"/></svg></span><span class="orbit-tab-label">Comps</span></button>
<button class="app-tab" data-apptab="sfx" title="Library"><span class="orbit-tab-icon"><svg viewBox="0 0 20 20"><path d="M2.5 5.5h6l1.5 2h7.5v9h-15Z"/><path d="M2.5 5.5v-2h6l1.5 2h6"/></svg></span><span class="orbit-tab-label">Library</span></button>
<button class="app-tab rail-purge" data-tool="purge" title="RAM Purge — clear all AE caches" type="button"><span class="orbit-tab-icon"><svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="4" y="5" width="12" height="10" rx="2"/><path d="M7 2v3m6-3v3M7 15v3m6-3v3M1 8h3m-3 4h3m12-4h3m-3 4h3M11 7l-3 4h4l-2 3"/></svg></span><span class="orbit-tab-label">Purge</span></button>
    <button type="button" id="cx-settings-btn" class="cx-icon-btn rail-account" title="Plugin Settings">
      <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="8" cy="8" r="2.2"></circle>
        <path d="M8 1.5v1.6M8 12.9v1.6M14.5 8h-1.6M3.1 8H1.5M12.5 3.5l-1.1 1.1M4.6 11.4l-1.1 1.1M12.5 12.5l-1.1-1.1M4.6 4.6 3.5 3.5"></path>
      </svg>
    <span class="rail-account-label">Settings</span></button>
    <button type="button" id="cx-signout-btn" class="cx-icon-btn rail-account" title="Sign Out / Release License">
      <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M6 2H3a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"></path>
        <polyline points="10 12 14 8 10 4"></polyline>
        <line x1="14" y1="8" x2="5" y2="8"></line>
      </svg>
    <span class="rail-account-label">Logout</span></button>
</nav>
<div class="app-panel active" id="panel-tools">
<div class="tools-scroll">
<div class="tool-dash-row tools-primary-row">
<div class="tool-section matrix-transform">
<div class="tool-section-head">
<div class="tool-section-title">ALIGN &amp; ANCHOR</div>
<span class="tool-help" title="Aligns selected layers relative to the comp (single layer) or the selection's bounding box (multiple layers).">?</span>
</div>
<div class="matrix-transform-body">
<div class="matrix-align-block">
<div class="matrix-mini-title">ALIGN</div>
<div class="tool-grid tool-grid-3 icon-only">
<button class="tool-btn" data-arg="left" data-tool="align" title="Align Left" data-orbit-icon="left">Left</button>
<button class="tool-btn" data-arg="hcenter" data-tool="align" title="Align Horizontal Center" data-orbit-icon="hcenter">H Center</button>
<button class="tool-btn" data-arg="right" data-tool="align" title="Align Right" data-orbit-icon="right">Right</button>
<button class="tool-btn" data-arg="top" data-tool="align" title="Align Top" data-orbit-icon="top">Top</button>
<button class="tool-btn" data-arg="vcenter" data-tool="align" title="Align Vertical Center" data-orbit-icon="vcenter">V Center</button>
<button class="tool-btn" data-arg="bottom" data-tool="align" title="Align Bottom" data-orbit-icon="bottom">Bottom</button>
</div>
</div>
<div class="matrix-anchor-block" title="Moves the anchor point within the layer's bounds without shifting it on screen.">
<div class="matrix-mini-title">ANCHOR POINT</div>
<div class="tool-grid tool-grid-3 cx-anchor-grid icon-only">
<button class="tool-btn anchor-dot-btn" data-arg="tl" data-tool="anchor" title="Top Left"><span class="anchor-dot"></span></button>
<button class="tool-btn anchor-dot-btn" data-arg="t" data-tool="anchor" title="Top"><span class="anchor-dot"></span></button>
<button class="tool-btn anchor-dot-btn" data-arg="tr" data-tool="anchor" title="Top Right"><span class="anchor-dot"></span></button>
<button class="tool-btn anchor-dot-btn" data-arg="l" data-tool="anchor" title="Left"><span class="anchor-dot"></span></button>
<button class="tool-btn anchor-dot-btn active" data-arg="c" data-tool="anchor" title="Center"><span class="anchor-dot center-dot"></span></button>
<button class="tool-btn anchor-dot-btn" data-arg="r" data-tool="anchor" title="Right"><span class="anchor-dot"></span></button>
<button class="tool-btn anchor-dot-btn" data-arg="bl" data-tool="anchor" title="Bottom Left"><span class="anchor-dot"></span></button>
<button class="tool-btn anchor-dot-btn" data-arg="b" data-tool="anchor" title="Bottom"><span class="anchor-dot"></span></button>
<button class="tool-btn anchor-dot-btn" data-arg="br" data-tool="anchor" title="Bottom Right"><span class="anchor-dot"></span></button>
</div>
</div>
<div class="matrix-flip-block">
<div class="matrix-mini-title"><span>FLIP</span><label class="qa-switch" title="Convert pasted SVG artwork to a Shape Layer"><input id="pastaToShapes" type="checkbox"/><span class="qa-switch-track"><span class="qa-switch-dot"></span></span><span class="qa-switch-label">SVG Shape</span></label></div>
<div class="tool-grid tool-grid-3">
<button class="tool-btn" data-tool="flip" data-arg="horizontal" title="Flip selected layer(s) horizontally" data-orbit-icon="flip-h">H Flip</button>
<button class="tool-btn" data-tool="flip" data-arg="vertical" title="Flip selected layer(s) vertically" data-orbit-icon="flip-v">V Flip</button>
<button class="tool-btn" id="btnPasteFeature" title="Paste the image currently stored on the system clipboard into the active composition" data-orbit-icon="clipboard">Pasta</button>
</div>
</div>
</div>
</div>
<div class="tool-section tools-project-row tools-project-section">
<div class="tool-section-head">
<div class="tool-section-title">PROJECT UTILITIES</div>
<span class="tool-help" title="Precomp Tog: standard precompose. Precomp Sep: precomposes each selected layer into its own comp. Unprecomp: pulls a precomp's layers back out and removes it. Organize: opens a preview dialog to sort project panel items into folders (Comps, Precomps, Footage/Video/Images/Audio/3D, Solids, Unused) with Standard or Smart presets.">?</span>
</div>
<div class="tool-grid tool-grid-2">
<button class="tool-btn" data-arg="true" data-tool="precompose" title="Precompose the selection" data-orbit-icon="precomp">Precomp</button>
<button class="tool-btn" data-tool="precomposeSeparate" title="Precompose each selected layer into its own comp" data-orbit-icon="layers">Precomp Separate</button>
<button class="tool-btn" data-tool="unprecompose" title="Copy a precomp's layers back into this composition and remove the precomp layer" data-orbit-icon="unprecomp">Unprecomp</button>
<button class="tool-btn primary" id="btnOrganizeApply" title="Automatically organize all project panel items into categorized folders" data-orbit-icon="folder">Organize</button>
</div>
</div>
</div>
<div class="tool-dash-row tool-dash-row-2 tool-dash-row-clipboard tools-workflow-row">
<div class="tool-section matrix-trim">
<div class="tool-section-head"><div class="tool-section-title">QUICK MODIFY</div></div>
<div class="tool-grid tool-grid-4" style="margin-top: 2px;">
<button class="tool-btn" data-tool="trimBefore" title="Trim selected layers before playhead" data-orbit-icon="before">Trim Before</button>
<button class="tool-btn" data-tool="trimAfter" title="Trim selected layers after playhead" data-orbit-icon="after">Trim After</button>
<button class="tool-btn" id="btnFxLock" title="Freeze current effect settings while keeping the layer movable. Click again to unlock CompX FX Lock settings." data-orbit-icon="lock">FX Lock</button>
<button class="tool-btn danger" id="btnFxRemove" title="Remove every effect from the selected layer(s)" data-orbit-icon="remove">FX Remove</button>
</div>
<div class="tool-grid tool-grid-2" style="margin-top: 2px;">
<button class="tool-btn primary" id="btnPropertyBounce" title="Apply the bounce expression to every selected expression-capable property" data-orbit-icon="bounce">Bounce</button>
<button class="tool-btn primary" id="btnNpApply-liquidglass" title="Apply the Liquid Glass effect to the selected layer(s). Install it once from the Plugin Settings menu first." data-orbit-icon="tint">Liquid Glass</button>
</div>
</div>
<div class="tool-section tools-native-section">
<div class="tool-section-head">
<div class="tool-section-title">NATIVE EFFECTS</div>
<span class="tool-help" title="Apply bundled native plugins to the selected layer(s). Install them once from the Plugin Settings menu first.">?</span>
</div>
<div class="tool-grid tool-grid-2">
<button class="tool-btn primary" id="btnNpApply-deepglow" title="Apply Deep Glow to the selected layer(s). Install once from Plugin Settings." data-orbit-icon="glow">Deep Glow</button>
<button class="tool-btn primary" id="btnNpApply-deepglow2" title="Apply Deep Glow 2 to the selected layer(s). Install once from Plugin Settings." data-orbit-icon="glow">Deep Glow 2</button>
<button class="tool-btn primary" id="btnNpApply-shadow2" title="Apply Shadow Studio 2 to the selected layer(s). Install once from Plugin Settings." data-orbit-icon="shadow">Shadow Studio 2</button>
<button class="tool-btn primary" id="btnNpApply-shadow3" title="Apply Shadow Studio 3 to the selected layer(s). Install once from Plugin Settings." data-orbit-icon="shadow">Shadow Studio 3</button>
</div>
</div>
</div>
<div class="tool-section creation-tools-section">
<div class="tool-section-head">
<div class="tool-section-title">CREATE &amp; QUICK TOOLS</div>
<span class="tool-help" title="Quick layer, effect, and shape creation shortcuts.">?</span>
</div>
<div class="tool-subgroup subgroup-layers">
<div class="tool-subgroup-title">
<span>QUICK ACTIONS</span>
<label class="qa-switch" title="Match new layer duration to the selected layer"><input type="checkbox" id="chkMatchLayerDuration"/><span class="qa-switch-track"><span class="qa-switch-dot"></span></span><span class="qa-switch-label">Match Duration</span></label>
</div>
<div class="tool-grid tool-grid-6">
<button class="tool-btn" data-arg="solid" data-tool="createLayer" title="Create a solid color layer" data-orbit-icon="solid">Solid</button>
<button class="tool-btn" data-arg="null" data-tool="createLayer" title="Create a null layer" data-orbit-icon="null">Null</button>
<button class="tool-btn" data-arg="camera" data-tool="createLayer" title="Create a camera layer" data-orbit-icon="camera">Camera</button>
<button class="tool-btn" data-arg="text" data-tool="createLayer" title="Create a text layer" data-orbit-icon="text">Text</button>
<button class="tool-btn" data-arg="adjustment" data-tool="createLayer" title="Create an adjustment layer" data-orbit-icon="adjustment">Adjust</button>
<button class="tool-btn" data-tool="createShape" title="Create a shape layer" data-orbit-icon="shape">Shape</button>
</div>
</div>
<div class="tool-subgroup subgroup-effects">
<div class="tool-subgroup-title">EFFECTS BROWSER</div>
<div class="tool-grid tool-grid-5">
<button class="tool-btn" data-arg="ADBE Ramp" data-tool="effect" title="Apply Gradient Ramp effect" data-orbit-icon="gradient">Gradient</button>
<button class="tool-btn" data-arg="ADBE Glo2" data-tool="effect" title="Apply Glow effect" data-orbit-icon="glow">Glow</button>
<button class="tool-btn" data-arg="ADBE Fill" data-tool="effect" title="Apply Fill effect" data-orbit-icon="fill">Fill</button>
<button class="tool-btn" data-arg="ADBE Tint" data-tool="effect" title="Apply Tint effect" data-orbit-icon="tint">Tint</button>
<button class="tool-btn" data-arg="ADBE Gaussian Blur 2" data-tool="effect" title="Apply Blur effect" data-orbit-icon="blur">Blur</button>
</div>
</div>
<div class="tool-subgroup subgroup-timeline">
<div class="tool-subgroup-title">TIMELINE UTILITIES</div>
<div class="tool-grid tool-grid-4">
<button class="tool-btn" data-tool="trimOut" title="Trim layer out point at playhead" data-orbit-icon="trim">Trim Out</button>
<button class="tool-btn" data-tool="splitAtPlayhead" title="Split selected layer at playhead" data-orbit-icon="split">Split at Playhead</button>
<button class="tool-btn" data-tool="splitMasks" title="Split multi-mask layers" data-orbit-icon="masks">Split Masks</button>
<button class="tool-btn" data-tool="trueDuplicate" title="True-duplicate: independent source comp copy" data-orbit-icon="duplicate">True Duplicate</button>
<button class="tool-btn" id="btnNumberCounter" type="button" aria-haspopup="dialog" aria-controls="numberCounterModal" aria-expanded="false" title="Open Number Counter" data-orbit-icon="counter">123 Counter</button>
<button class="tool-btn" data-tool="xactCrop" title="Xact Crop: Crops the selected precomp using advanced detection over time." data-orbit-icon="crop">Xact Crop</button>
<button class="tool-btn" data-tool="xpertCrop" title="Xpert Crop: Automatically precomposes and then crops the selected layer(s)." data-orbit-icon="xpert">Xpert Crop</button>
<button class="tool-btn" data-tool="xCrop" title="X Crop: Crops the current comp or selected precomp at the current frame." data-orbit-icon="xcrop">X Crop</button>
</div>
</div>
<div class="tool-subgroup subgroup-textmask">
<div class="tool-subgroup-title">TEXT / MASK TOOLS</div>
<div class="tool-grid tool-grid-2">
<button class="tool-btn" data-tool="capitalize" title="Uppercase text layer content" data-orbit-icon="uppercase">Uppercase</button>
<button class="tool-btn wide" id="btnExplodeTextPro" title="Split the selected text layer into one animated layer per character" data-orbit-icon="explode">Explode</button>
</div>
</div>
</div>
</div>
</div>
<div class="app-panel" id="panel-studio">
<div class="tools-scroll">
<!-- Flex AutoCaptions -->
<div class="tool-section cx-caption-studio-card" id="flexAutoCaptions">
<div class="cx-simple-srt">
<div class="cx-cap-header cx-cap-header-studio">
<div class="cx-cap-header-icon">CC</div>
<div class="cx-cap-header-copy"><div class="cx-cap-title">Caption Studio</div><div class="cx-cap-sub">Create • Style • Animate</div></div>
<span class="cx-cap-ready"><i></i>SIMPLE</span>
</div>
<div class="cx-cap-stepbar">
<button class="cx-cap-stepbar-step active" data-simple-caption-stage="source" type="button"><span>01</span><b>SOURCE</b><small>Choose or transcribe</small></button>
<i class="cx-cap-stepbar-arrow">›</i>
<button class="cx-cap-stepbar-step" data-simple-caption-stage="style" disabled type="button"><span>02</span><b>ANIMATION</b><small>Select style, then create</small></button>
</div>
<div class="cx-simple-stage-panel" data-simple-stage-panel="source">
<div class="cx-cap-sources">
<div class="cx-cap-source-card transcribe active">
<div class="cx-cap-source-icon">▶</div>
<strong>Transcribe Media</strong>
<span>Video or Audio</span>
<button class="tool-btn" id="btnSimpleMediaPick" type="button">SELECT MEDIA</button>
