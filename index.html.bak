<!-- Custom Modal Popup (must live outside .app-panel so it stays visible on every tab) -->
<div class="modal-backdrop" id="lgSettingsModal" style="display:none;">
<div class="modal-box lg-settings-box" id="lgSettingsBox">
<div class="modal-header lg-settings-header">
  <span class="lg-settings-header-icon" aria-hidden="true">⚙</span>
  <span class="lg-settings-header-title">Plugin Settings</span>
</div>
<div class="modal-body lg-settings-body">
  <div class="lg-plugin-card">
    <div class="lg-plugin-card-top">
      <div class="lg-plugin-card-icon" aria-hidden="true">✨</div>
      <div class="lg-plugin-card-heading">
        <div class="lg-plugin-card-name">Native Plugin</div>
        <div class="lg-plugin-card-tags">
          <span class="lg-plugin-chip">Liquid Glass</span>
          <span class="lg-plugin-chip">Deep Glow</span>
          <span class="lg-plugin-chip">Shadow Studio</span>
        </div>
      </div>
      <span class="tool-help lg-plugin-help" title="One-time install copies the real After Effects effect into your Plug-ins folder. After that, Apply adds it to the selected layer with full native, animatable, GPU-speed controls in AE's own Effect Controls panel.">?</span>
    </div>
    <p class="lg-plugin-card-desc">Install once into your After Effects Plug-ins folder. Windows gets the .aex pack; macOS installs Liquid Glass, Deep Glow 2 and Shadow Studio 3 from the bundled .plugin. Restart AE, then use the Tools-tab buttons on a selected layer.</p>
    <div class="lg-native-pack" id="lgNativePack">
      <div class="lg-native-row" data-native-plugin="liquidglass"><b>Liquid Glass</b><span class="lg-plugin-chip">Win + Mac</span><span class="lg-status" id="npStatus-liquidglass">Checking…</span><button class="tool-btn primary lg-action-btn" type="button" data-np-install="liquidglass">Install</button><button class="tool-btn danger lg-action-btn" type="button" data-np-uninstall="liquidglass" hidden>Uninstall</button></div>
      <div class="lg-native-row" data-native-plugin="deepglow"><b>Deep Glow</b><span class="lg-status" id="npStatus-deepglow">Checking…</span><button class="tool-btn primary lg-action-btn" type="button" data-np-install="deepglow">Install</button><button class="tool-btn danger lg-action-btn" type="button" data-np-uninstall="deepglow" hidden>Uninstall</button></div>
      <div class="lg-native-row" data-native-plugin="deepglow2"><b>Deep Glow 2</b><span class="lg-plugin-chip">Win + Mac</span><span class="lg-status" id="npStatus-deepglow2">Checking…</span><button class="tool-btn primary lg-action-btn" type="button" data-np-install="deepglow2">Install</button><button class="tool-btn danger lg-action-btn" type="button" data-np-uninstall="deepglow2" hidden>Uninstall</button></div>
      <div class="lg-native-row" data-native-plugin="shadow2"><b>Shadow Studio 2</b><span class="lg-status" id="npStatus-shadow2">Checking…</span><button class="tool-btn primary lg-action-btn" type="button" data-np-install="shadow2">Install</button><button class="tool-btn danger lg-action-btn" type="button" data-np-uninstall="shadow2" hidden>Uninstall</button></div>
      <div class="lg-native-row" data-native-plugin="shadow3"><b>Shadow Studio 3</b><span class="lg-plugin-chip">Win + Mac</span><span class="lg-status" id="npStatus-shadow3">Checking…</span><button class="tool-btn primary lg-action-btn" type="button" data-np-install="shadow3">Install</button><button class="tool-btn danger lg-action-btn" type="button" data-np-uninstall="shadow3" hidden>Uninstall</button></div>
      <button class="tool-btn primary lg-action-btn" id="btnNpInstallAll" type="button">Install All Native Plugins</button>
    </div>
    <div class="hint lg-settings-hint">One-time step — copies the effect into your After Effects Plug-ins folder. Restart After Effects after installing.</div>
  </div>
  <div class="lg-plugin-card" id="stgCardFonts">
    <div class="lg-plugin-card-top">
      <div class="lg-plugin-card-icon" aria-hidden="true">🔤</div>
      <div class="lg-plugin-card-heading">
        <div class="lg-plugin-card-name">Bangla Fonts</div>
        <div class="lg-plugin-card-tags"><span class="lg-plugin-chip">Auto Captions</span><span class="lg-plugin-chip">One-time</span></div>
      </div>
    </div>
    <p class="lg-plugin-card-desc">Install the bundled Bangla caption fonts once so they appear in After Effects' font menus. The live preview works from the extension without installing.</p>
    <button class="tool-btn primary lg-action-btn" data-obs id="btnInstallBanglaFonts" type="button">⬇ Install Bangla Fonts</button>
    <div class="hint" id="banglaFontStatus">Fonts are used by the Auto Captions live preview. Install once to use them inside After Effects.</div>
  </div>
  <div class="lg-plugin-card" id="stgCardAutoCaptions">
    <div class="lg-plugin-card-top">
      <div class="lg-plugin-card-icon" aria-hidden="true">🎙️</div>
      <div class="lg-plugin-card-heading">
        <div class="lg-plugin-card-name">Auto Captions Runtime</div>
        <div class="lg-plugin-card-tags"><span class="lg-plugin-chip">Whisper</span><span class="lg-plugin-chip">Local</span></div>
      </div>
    </div>
    <div id="flexRuntimeConsent">
      <p class="lg-plugin-card-desc" id="flexRuntimeConsentText">CompX will download a private local transcription runtime. No system software or PATH changes.</p>
      <progress id="flexRuntimeProgress" max="100" value="0"></progress>
      <div class="lg-plugin-card-actions">
        <button class="tool-btn primary lg-action-btn" data-obs id="btnFlexRuntimeAllow" type="button">⬇ Download &amp; Continue</button>
        <button class="tool-btn ghost lg-action-btn" id="btnFlexRuntimeCancel" type="button">Not Now</button>
      </div>
    </div>
  </div>
  <div class="lg-plugin-card" id="stgCardBgRemover">
    <div class="lg-plugin-card-top">
      <div class="lg-plugin-card-icon" aria-hidden="true">🖼️</div>
      <div class="lg-plugin-card-heading">
        <div class="lg-plugin-card-name">Background Remover Model</div>
        <div class="lg-plugin-card-tags"><span class="lg-plugin-chip">U²-Net</span><span class="lg-plugin-chip">Local</span></div>
      </div>
    </div>
    <div id="aiBgRuntimeConsent">
      <p class="lg-plugin-card-desc">CompX will download the verified U²-Net model once (about 168 MB). Images stay on this computer and there is no per-image cost.</p>
      <progress id="aiBgRuntimeProgress" max="100" value="0"></progress>
      <div class="lg-plugin-card-actions">
        <button class="tool-btn primary lg-action-btn" data-obs id="btnAiBgRuntimeAllow" type="button">⬇ Download &amp; Continue</button>
        <button class="tool-btn ghost lg-action-btn" id="btnAiBgRuntimeCancel" type="button">Not Now</button>
      </div>
    </div>
  </div>
</div>
<div class="modal-footer">
<button class="btn primary" id="lgSettingsClose">Close</button>
</div>
</div>
</div>
